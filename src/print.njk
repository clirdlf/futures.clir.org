---
layout: base.njk
title: Print Edition
bodyClass: print-edition-page
permalink: /print/
---
<div class="print-edition">
  <div class="print-controls">
    <p>This edition is formatted for your browser’s Print to PDF command. In More settings, use Letter paper and 100% scale.</p>
    <button type="button" onclick="window.print()">Print or save as PDF</button>
  </div>

  <header class="print-cover">
    <div class="print-cover__art" aria-hidden="true"></div>
    <div class="print-cover__panel">
      <p class="print-cover__kicker">CLIR Postdoctoral Fellowship</p>
      <h1>A Third Library is Possible</h1>
      <p class="print-cover__subtitle">Curated Futures Project</p>
      <p class="print-cover__editors">Faithe Day, Synatra Smith, Jodi Reeves Eyre, John Maclachlan, and Christa Williford, editors</p>
      <div class="print-cover__imprint">
        <p><strong>CLIR</strong><span>Council on Library &amp;<br>Information Resources</span></p>
        <time datetime="2022-01">January 2022</time>
      </div>
    </div>
  </header>

  <section class="print-section print-section--about">
    {% for item in collections.all %}
      {% if item.url == '/about/' %}<div class="print-about-content">{{ item.templateContent | safe }}</div>{% endif %}
    {% endfor %}
  </section>

  {% for contribution in collections.contributions %}
    <section class="print-section print-contribution">
      <header class="print-entry-header">
        <p class="section-label">Contribution {{ loop.index }}</p>
        <h2>{{ contribution.data.title }}</h2>
        <p class="print-entry-byline">
          {% if contribution.data.authors %}
            {% for person in contribution.data.authors %}<span>{{ (person.name or person) | safe }}</span>{% endfor %}
          {% elif contribution.data.author %}
            <span>{{ contribution.data.author | safe }}</span>
          {% endif %}
        </p>
        {% if contribution.data.affiliation %}<p class="print-entry-affiliation">{{ contribution.data.affiliation | safe }}</p>{% endif %}
      </header>
      <div class="print-entry-content prose">{{ contribution.templateContent | safe }}</div>
    </section>
  {% endfor %}

  <section class="print-section print-section--attribution">
    <div class="print-entry-content prose">
      <h2>Attribution</h2>
      <p>Unless otherwise indicated, content is available for reuse under the <a href="{{ site.licenseUrl }}">{{ site.license }}</a>. This static edition preserves the original Curated Futures Project content structure and links back to <a href="{{ site.source }}">the original publication</a>.</p>
    </div>
  </section>
</div>
