      </div>
    </div>
    <div class="site-footer__legal"><a href="https://www.clir.org/"><img src="/assets/CLIR-logo-unbounded-red.svg" alt="CLIR" eleventy:ignore></a><p>Unless otherwise indicated, content on this site is available for re-use under <a class="underline" href="{{ site.licenseUrl }}">{{ site.license }} License</a></p></div>
  </footer>
  <script src="/js/scroll-top.js" defer></script>
</body>
</html>
