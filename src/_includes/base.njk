<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <title>{{ title }} | {{ site.title }}</title>
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body class="bg-paper text-ink">
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="clir-bar"><div class="clir-bar__inner"><div class="clir-links"><a href="https://www.clir.org/">CLIR</a><a href="https://www.clir.org/fellowships/">Fellowships &amp; Grants</a><a href="https://www.diglib.org/">DLF</a><a href="https://www.clir.org/pubs/">Publications</a><a href="https://www.clir.org/global/">CLIR Global</a></div><div class="clir-actions"><a href="https://www.clir.org/about/community/">Join</a><a href="https://www.clir.org/give/">Give</a></div></div></div>
  <header class="site-header"><div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="CLIR Postdoctoral Fellowship Program home"><img src="/assets/clir-postdoctoral-fellowship.svg" alt="CLIR Postdoctoral Fellowship Program"></a>
    <nav aria-label="Primary navigation">{% if page.url == '/present-encounters/' or articleStyle == 'feature' %}<a href="/about/">About</a><a href="/#contributions">Contributions</a><a href="https://futures.clir.org/acknowledgements/">Acknowledgements</a><a href="/?s=" aria-label="Search">⌕</a>{% else %}{% for item in navigation %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}{% endif %}</nav>
  </div></header>
  <main id="content">{{ content | safe }}</main>
  <button class="scroll-top" type="button" aria-label="Scroll to top" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m5 15 7-7 7 7" />
    </svg>
  </button>
  <footer class="site-footer" id="site-footer">
    <div class="site-footer__main">
      <div class="footer-contact">
        <img src="https://futures.clir.org/wp-content/uploads/sites/41/2021/11/clir.png" alt="CLIR">
        <address>
          <strong>Council on Library and Information Resources</strong><br>
          1800 Diagonal Rd<br>
          Suite 600<br>
          Alexandria, VA 22314<br>
          <a href="mailto:contact@clir.org">contact@clir.org</a>
        </address>
      </div>
      <div class="footer-about">
        <h2>About</h2>
        <p>CLIR is an independent, nonprofit organization that forges strategies to enhance research, teaching, and learning environments in collaboration with libraries, cultural institutions, and communities of higher learning.</p>
        <a href="https://www.clir.org/privacy/">Privacy</a>
      </div>
      <div class="footer-connect">
        <h2>Stay In Touch</h2>
        <p>Sign up for news from CLIR.</p>
        <a class="footer-signup" href="https://clir.informz.net/clir/pages/cf">Sign Up</a>
        <h2>Follow CLIR</h2>
        <div class="social-links">
          <a href="https://www.facebook.com/CLIRNews/" aria-label="Follow CLIR on Facebook">f</a>
          <a href="https://twitter.com/CLIRNews" aria-label="Follow CLIR on X">𝕏</a>
          <a href="https://www.youtube.com/@CLIRNews" aria-label="Follow CLIR on YouTube">▶</a>
          <a href="https://www.linkedin.com/company/clir/" aria-label="Follow CLIR on LinkedIn">in</a>
          <a href="https://www.clir.org/feed/" aria-label="Subscribe to the CLIR RSS feed">◔</a>
        </div>
      </div>
    </div>
    <div class="site-footer__legal"><a href="https://www.clir.org/">CLIR</a><p>Unless otherwise indicated, content on this site is available for re-use under <a href="{{ site.licenseUrl }}">{{ site.license }} License</a></p></div>
  </footer>
  <script src="/js/search.js" defer></script>
  <script src="/js/scroll-top.js" defer></script>
</body>
</html>
