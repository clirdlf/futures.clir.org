<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <title>{{ title }} | {{ site.title }}</title>
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body class="bg-paper text-ink">
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="clir-bar"><div class="clir-bar__inner"><div class="clir-links"><a href="https://www.clir.org/">CLIR</a><a href="https://www.clir.org/fellowships/">Fellowships &amp; Grants</a><a href="https://www.diglib.org/">DLF</a><a href="https://www.clir.org/pubs/">Publications</a><a href="https://www.clir.org/global/">CLIR Global</a></div><div class="clir-actions"><a href="https://www.clir.org/about/community/">Join</a><a href="https://www.clir.org/give/">Give</a></div></div></div>
  <header class="site-header"><div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="CLIR Postdoctoral Fellowship Program home"><img src="/assets/clir-postdoctoral-fellowship.svg" alt="CLIR Postdoctoral Fellowship Program"></a>
    <nav aria-label="Primary navigation">{% if page.url == '/present-encounters/' %}<a href="/about/">About</a><a href="/#contributions">Contributions</a><a href="https://futures.clir.org/acknowledgements/">Acknowledgements</a><a href="/?s=" aria-label="Search">⌕</a>{% else %}{% for item in navigation %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}{% endif %}</nav>
  </div></header>
  <main id="content">{{ content | safe }}</main>
  <button class="scroll-top" type="button" aria-label="Scroll to top" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m5 15 7-7 7 7" />
    </svg>
  </button>
  <footer class="site-footer"><div class="footer-brand"><img src="/assets/clir-postdoctoral-fellowship.svg" alt="CLIR Postdoctoral Fellowship Program"><p>© Council on Library and Information Resources</p><a href="{{ site.licenseUrl }}">{{ site.license }}</a></div><div><strong>About</strong><p>CLIR is an independent, nonprofit organization that forges strategies to enhance research, teaching, and learning environments in collaboration with libraries, cultural institutions, and communities of higher learning.</p><a href="https://www.clir.org/">Learn more</a></div><div><strong>Stay in Touch</strong><p><a href="mailto:postdoc@clir.org">postdoc@clir.org</a></p><strong>Follow CLIR</strong><p class="social-links"><a href="https://www.facebook.com/CLIRNews/">f</a><a href="https://www.instagram.com/clirnews/">◎</a><a href="https://www.linkedin.com/company/clir/">in</a><a href="https://www.youtube.com/@CLIRNews">▶</a></p></div></footer>
  <script src="/js/search.js" defer></script>
  <script src="/js/scroll-top.js" defer></script>
</body>
</html>
