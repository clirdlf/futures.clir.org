<!doctype html>
<html lang="en">
<head>
  {% set pageTitle = site.title if title == 'Home' else title + ' | ' + site.title %}
  {% set pageDescription = description or excerpt or site.description %}
  {% set canonicalUrl = page.url | absoluteUrl(site.source) %}
  {% set socialImage = (articleHero or hero or site.socialImage) | absoluteUrl(site.source) %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ pageDescription }}">
  <title>{{ pageTitle }}</title>
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ 'article' if layout == 'article.njk' else 'website' }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ socialImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ socialImage }}">
  {% if layout == 'article.njk' %}
    {% if date %}<meta property="article:published_time" content="{{ date }}-01">{% endif %}
    {% for topic in topics %}<meta property="article:tag" content="{{ topic }}">{% endfor %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ScholarlyArticle",
        "headline": {{ title | json | safe }},
        "description": {{ pageDescription | json | safe }},
        "url": {{ canonicalUrl | json | safe }},
        "mainEntityOfPage": {{ canonicalUrl | json | safe }},
        "image": {{ socialImage | json | safe }},
        {% if date %}"datePublished": {{ (date + '-01') | json | safe }},{% endif %}
        "author": [
          {% if authors %}
            {% for person in authors %}{"@type": "Person", "name": {{ (person.name or person) | json | safe }}{% if person.url %}, "url": {{ person.url | json | safe }}{% endif %}}{% if not loop.last %},{% endif %}{% endfor %}
          {% elif author %}
            {"@type": "Person", "name": {{ author | json | safe }}}
          {% endif %}
        ],
        "publisher": {"@type": "Organization", "name": "Council on Library and Information Resources", "url": "https://www.clir.org/"}
      }
    </script>
  {% endif %}
  <link rel="icon" href="/assets/favicon/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/assets/favicon/site.webmanifest">
  {% if title == 'Home' %}<link rel="preload" href="/assets/curated-futures-pattern-3.svg" as="image" type="image/svg+xml" fetchpriority="high">{% endif %}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&amp;family=Public+Sans:wght@400;500;600;700&amp;display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&amp;family=Public+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"></noscript>
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body class="bg-paper text-ink{% if bodyClass %} {{ bodyClass }}{% endif %}">
  <a class="skip-link" href="#content">Skip to content</a>
  {# <div class="clir-bar"><div class="clir-bar__inner"><div class="clir-links"><a href="https://www.clir.org/">CLIR</a><a href="https://www.clir.org/fellowships/">Fellowships &amp; Grants</a><a href="https://www.diglib.org/">DLF</a><a href="https://www.clir.org/pubs/">Publications</a><a href="https://www.clir.org/global/">CLIR Global</a></div><div class="clir-actions"><a href="https://www.clir.org/about/community/">Join</a><a href="https://www.clir.org/give/">Give</a></div></div></div> #}
  <header class="site-header"><div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="CLIR Postdoctoral Fellowship Program home"><img src="/assets/clir-postdoctoral-fellowship.svg" alt="CLIR Postdoctoral Fellowship Program" eleventy:ignore></a>
    <nav aria-label="Primary navigation">{% if page.url == '/present-encounters/' or articleStyle == 'feature' %}<a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a><a href="/#contributions">Contributions</a><a href="/acknowledgments/">Acknowledgments</a>
    {# <a href="/#site-search">Search</a> #}
    {% else %}{% for item in navigation %}<a href="{{ item.url }}"{% if page.url == item.url or (item.url == '/#contributions' and page.url == '/') %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}{% endif %}</nav>
  </div>
  </header>
  <main id="content">{{ content | safe }}</main>
  <button class="scroll-top" type="button" aria-label="Scroll to top" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m5 15 7-7 7 7" />
    </svg>
  </button>
  <footer class="site-footer" id="site-footer">
    <div class="site-footer__main">
      <div class="footer-contact">
        <img src="/assets/CLIR-logo-banner-red.svg" alt="CLIR" eleventy:ignore>
        <address>
          <strong>Council on Library and Information Resources</strong><br>
          1800 Diagonal Rd<br>
          Suite 600<br>
          Alexandria, VA 22314<br>
          <a href="mailto:contact@clir.org">contact@clir.org</a>
        </address>
      </div>
      <div class="footer-about">
        <h2>About</h2>
        <p>CLIR advances enduring and ever expanding access to knowledge, facilitating collaborations, innovation, leadership, and community connection across international information landscapes.</p>
        <a href="https://www.clir.org/privacy/">Privacy</a>
      </div>
      <div class="footer-connect">
        <h2>Stay In Touch</h2>
        <p>Sign up for news from CLIR.</p>
        <a class="footer-signup" href="https://clir.informz.net/clir/pages/cf">Sign Up</a>
        <h2>Follow CLIR</h2>
