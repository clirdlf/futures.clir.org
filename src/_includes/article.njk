---
layout: base.njk
---
<article class="article-shell{% if page.url == '/present-encounters/' or articleStyle == 'feature' %} article-feature{% endif %}">
    {% if page.url == '/present-encounters/' or articleStyle == 'feature' %}
        {% if articleHero or hero %}
            <header class="article-header" style="background-image:url('{{ articleHero or hero }}')">
                <div class="article-header__inner">
                    <h1>{{ title }}</h1>
                </div>
            </header>
        {% endif %}
        <div class="article-byline{% if author and not authors %} article-byline--single{% endif %}">
            <p class="eyebrow">Written by</p>
            <p class="article-author">
                {% if authors %}
                    {% for person in authors %}
                        {% if person.url %}
                            <a href="{{ person.url }}">{{ person.name }}</a>
                        {% else %}
                            <span>{{ person.name or person }}</span>{% endif %}
                    {% endfor %}
                {% else %}
                    <span>{{ author }}</span>
                {% endif %}
            </p>
            {% if affiliation %}
                <p class="article-affiliation">{{ affiliation | safe }}</p>
            {% endif %}
            {% if editors_note %}
                <p class="article-editors-note"><em>{{ editors_note | safe }}</em></p>
            {% endif %}
        </div>
        {% if embed %}
            <div class="media-embed">
                <iframe src="{{ embed }}" title="{{ title }}" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe>
            </div>
        {% endif %}
        <div class="prose article-prose">{{ content | safe }}</div>
    {% else %}
        <header class="article-header"{% if articleHero %} style="background-image:url('{{ articleHero }}')"{% endif %}>
            <div class="article-header__inner">
                <p class="eyebrow">{{ date | readableDate }}</p>
                <h1>{{ title }}</h1>
                <p class="article-author">Written by <strong>
                        {% if authors %}
                            {% for person in authors %}
                                {% if person.url %}
                                    <a href="{{ person.url }}">{{ person.name }}</a>
                                {% else %}{{ person.name or person }}
                                {% endif %}
                                {% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% else %}{{ author }}
                        {% endif %}
                    </strong>
                </p>
                {% if affiliation %}
                    <p class="article-affiliation">{{ affiliation }}</p>
                {% endif %}
            </div>
        </header>
        {% if hero and not articleHero %}
            <figure class="article-hero-wrap"><img class="article-hero" src="{{ hero }}" alt="{{ heroAlt or title }}"></figure>
        {% endif %}
        {% if embed %}
            <div class="media-embed">
                <iframe src="{{ embed }}" title="{{ title }}" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe>
                <p>
                    <a class="text-link" href="{{ externalUrl or embed }}">Open this experience in a new tab <span aria-hidden="true">-&gt;</span></a>
                </p>
            </div>
        {% endif %}
        <div class="prose">{{ content | safe }}</div>
    {% endif %}
</article>
